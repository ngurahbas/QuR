<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/css/tailwind.css">
</head>
<body class="flex justify-center items-center px-4 min-h-screen bg-gray-50">
    <div class="w-full max-w-md">
        <div class="p-8 bg-white rounded-lg border border-gray-200 shadow-sm">
            <h1 class="mb-8 text-2xl font-semibold text-center text-gray-900">Sign in to your account</h1>
            
            <div class="space-y-3">
                <button disabled class="flex justify-center items-center py-3 px-4 w-full text-gray-900 bg-white rounded-lg border border-gray-300 border-l-4 border-l-green-500 opacity-60 transition-all duration-200 cursor-not-allowed shadow-md focus:ring-2 focus:ring-green-500 focus:ring-offset-2 focus:outline-none">
                    <span class="font-medium">Continue with WhatsApp</span>
                </button>

                <button disabled class="flex justify-center items-center py-3 px-4 w-full text-gray-900 bg-white rounded-lg border border-gray-300 border-l-4 border-l-blue-500 opacity-60 transition-all duration-200 cursor-not-allowed shadow-md focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:outline-none">
                    <span class="font-medium">Continue with SMS</span>
                </button>

                <a href="/oauth2/authorization/keycloak" class="flex justify-center items-center py-3 px-4 w-full text-gray-900 bg-white rounded-lg border border-gray-300 border-l-4 border-l-indigo-500 shadow-md transition-all duration-200 hover:bg-gray-50 hover:shadow-lg focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:outline-none">
                    <span class="font-medium">Continue with Keycloak</span>
                </a>
            </div>
            
            <div class="mt-6 text-center">
                <p class="text-sm text-gray-600">
                    By continuing, you agree to our 
                    <a href="#" class="text-blue-600 hover:text-blue-500">Terms of Service</a> 
                    and 
                    <a href="#" class="text-blue-600 hover:text-blue-500">Privacy Policy</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>